# Project C - Unity 6000.3.21f1
# Git attributes for a Unity 2D project

# ------------------------------------------------------------
# Text normalization
# ------------------------------------------------------------

* text=auto

*.cs            text eol=lf diff=csharp
*.json          text eol=lf
*.md            text eol=lf
*.txt           text eol=lf
*.xml           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# Unity package / project text files
*.asmdef        text eol=lf
*.asmref        text eol=lf
*.cginc         text eol=lf
*.compute       text eol=lf
*.hlsl          text eol=lf
*.shader        text eol=lf
*.shadergraph   text eol=lf
*.shadersubgraph text eol=lf
*.inputactions  text eol=lf
*.uss           text eol=lf
*.uxml          text eol=lf

